<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <AssemblyName>NOVor</AssemblyName>
    <RootNamespace>NOVor</RootNamespace>
    <Product>NO VOR CDI</Product>
    <Version>1.0.1</Version>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <OutputPath>bin\$(Configuration)</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Enables net472 compilation on Linux CI (no .NET Framework targeting pack there) -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies"
                      Version="1.0.3"
                      PrivateAssets="all"
                      Condition="'$(OS)' == 'Unix'" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Reference Include="Assembly-CSharp">
      <HintPath>$(NuclearOptionRoot)\NuclearOption_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mirage">
      <HintPath>$(NuclearOptionRoot)\NuclearOption_Data\Managed\Mirage.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="netstandard">
      <HintPath>$(NuclearOptionRoot)\NuclearOption_Data\Managed\netstandard.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(NuclearOptionRoot)\NuclearOption_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(NuclearOptionRoot)\NuclearOption_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(NuclearOptionRoot)\NuclearOption_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(NuclearOptionRoot)\NuclearOption_Data\Managed\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(NuclearOptionRoot)\NuclearOption_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(NuclearOptionRoot)\NuclearOption_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(NuclearOptionRoot)\NuclearOption_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Rewired_Core">
      <HintPath>$(NuclearOptionRoot)\NuclearOption_Data\Managed\Rewired_Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(NuclearOptionRoot)\NuclearOption_Data\Managed\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(NuclearOptionRoot)\NuclearOption_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(NuclearOptionRoot)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(NuclearOptionRoot)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Deploy NOVor.dll (+ PDB) to BepInEx/scripts/ for ScriptEngine hot reload (Debug only) -->
  <Target Name="DeployToScripts" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug' And '$(NuclearOptionRoot)' != ''">
    <Copy SourceFiles="$(OutputPath)NOVor.dll" DestinationFolder="$(NuclearOptionRoot)\BepInEx\scripts" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(OutputPath)NOVor.pdb" DestinationFolder="$(NuclearOptionRoot)\BepInEx\scripts" Condition="Exists('$(OutputPath)NOVor.pdb')" SkipUnchangedFiles="true" />
    <Message Text="Deployed NOVor.dll to $(NuclearOptionRoot)\BepInEx\scripts" Importance="high" />
  </Target>

  <!-- Create distribution ZIP with NOVor.dll for ScriptEngine installs -->
  <Target Name="CreateDistZip" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <DistBase>$(OutputPath)dist</DistBase>
      <DistZip>$(OutputPath)novor-$(Version).zip</DistZip>
    </PropertyGroup>

    <RemoveDir Directories="$(DistBase)" />
    <MakeDir Directories="$(DistBase)" />
    <Copy SourceFiles="$(OutputPath)NOVor.dll" DestinationFolder="$(DistBase)" />
    <ZipDirectory SourceDirectory="$(DistBase)" DestinationFile="$(DistZip)" Overwrite="true" />
    <RemoveDir Directories="$(DistBase)" />

    <Message Text="Created distribution ZIP: $(DistZip)" Importance="high" />
  </Target>

</Project>
